# Four distinct vendor families for x = 4 ensemble screening (config.json).
# Copy to .env and fill in values. .env is gitignored — never commit real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 4th vendor: Mistral, via attest's mistral provider (attest[mistral] extra,
# already included in attest[all]).
MISTRAL_API_KEY=
